# gitattributes — normalizzazione cross-platform.
# Tutto LF in repo (norma POSIX). Su Windows i tool moderni leggono LF senza problemi.
# Per applicare alle copie esistenti: `git add --renormalize .`

# Default: testo auto-detect, EOL LF in repo
* text=auto eol=lf

# Source code → LF rigoroso
*.ts          text eol=lf
*.tsx         text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.py          text eol=lf
*.json        text eol=lf
*.json5       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.md          text eol=lf
*.mdx         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.svg         text eol=lf
*.toml        text eol=lf
*.txt         text eol=lf
*.xml         text eol=lf
*.sql         text eol=lf

# App Swift originale (solo riferimento)
*.swift       text eol=lf
*.plist       text eol=lf
*.pbxproj     text eol=lf
*.xcscheme    text eol=lf

# Shell + script: DEVONO essere LF (CRLF rompe su Linux/Mac)
*.sh          text eol=lf
*.bash        text eol=lf

# Config (dotfiles senza estensione)
.editorconfig   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf
.npmrc          text eol=lf
.nvmrc          text eol=lf
.prettierrc     text eol=lf
.prettierignore text eol=lf
.env.example    text eol=lf
LICENSE         text eol=lf
lefthook.yml    text eol=lf

# Lockfile (LF, deve essere stabile cross-OS)
pnpm-lock.yaml  text eol=lf -diff merge=binary
uv.lock         text eol=lf -diff merge=binary

# Binari (no diff, no normalize)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.avif   binary
*.pdf    binary
*.zip    binary
*.tar.gz binary
*.tgz    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.mp3    binary
*.mp4    binary
*.webm   binary
*.mov    binary
*.wasm   binary
*.sqlite binary
*.db     binary
*.mlmodel     binary
*.sks         binary
*.xcuserstate binary

# Generato — collassa diff in PR (GitHub li nasconde di default)
pnpm-lock.yaml                linguist-generated=true
uv.lock                       linguist-generated=true
mobile/uniwind-types.d.ts     linguist-generated=true

# Esclusi da `git archive` / zip di release GitHub
.gitattributes export-ignore
.gitignore     export-ignore
.github/       export-ignore
.claude/       export-ignore
.vscode/       export-ignore
.editorconfig  export-ignore
AGENTS.md      export-ignore
CLAUDE.md      export-ignore

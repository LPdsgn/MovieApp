{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mooviefinder-tmdb-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// Pubblicato su https://mooviefinder-tmdb-proxy.luigipdt-dev.workers.dev; niente URL di anteprima per versione.
	"workers_dev": true,
	"preview_urls": false,
	// Il secret TMDB_TOKEN si imposta con `wrangler secret put TMDB_TOKEN`; in locale va in .dev.vars
	"observability": { "enabled": true },
}
